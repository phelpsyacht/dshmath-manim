{
  "name": "dshmath-manim",
  "version": "0.2.0",
  "description": "DeepSeek Harness math animation plugin powered by Manim CE (zero-code skills for math/physics users)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">23"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "manim",
    "math",
    "physics",
    "animation"
  ],
  "license": "Apache-2.0",
  "files": [
    "dist/",
    "py/",
    "skills/",
    "math-manim.cordis.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./math-manim.cordis.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify:dist": "npm run build && test -z \"$(git status --porcelain -- dist)\"",
    "prepack": "npm run build && find py -name __pycache__ -type d -prune -exec rm -rf {} + && find . -name '*.pyc' -not -path './node_modules/*' -delete",
    "prepublishOnly": "npm run build",
    "pack": "npm run build && npm pack"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0"
  }
}
